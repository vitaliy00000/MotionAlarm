<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MotionAlarm.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MotionAlarm.Pages"
    Shell.FlyoutBehavior="Flyout"
    Shell.BackgroundColor="{StaticResource AppBackground}"
    Shell.ForegroundColor="{StaticResource TextPrimary}"
    Shell.TitleColor="{StaticResource TextPrimary}"
    Shell.UnselectedColor="{StaticResource TextSecondary}"
    Title="MotionAlarm">

    <ShellContent Title="Охорона" ContentTemplate="{DataTemplate pages:HomePage}" Route="home" />
    <ShellContent Title="Налаштування" ContentTemplate="{DataTemplate pages:SettingsPage}" Route="settings" />
    <ShellContent Title="Журнал спрацювань" ContentTemplate="{DataTemplate pages:AlarmLogPage}" Route="alarm-log" />
</Shell>