<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MotionAlarm.Models"
             x:Class="MotionAlarm.Pages.AlarmLogPage"
             Title="Журнал спрацювань"
             BackgroundColor="{AppThemeBinding Light=#F7F8FA, Dark=#111318}">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="16">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="4">

            <Label Text="Журнал спрацювань"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#202124, Dark=#FFFFFF}" />

            <Label Text="Історія зафіксованого руху"
                   FontSize="15"
                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#A0A4AD}" />

        </VerticalStackLayout>

        <!-- Summary -->
        <Border Grid.Row="1"
                Padding="16"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1E24}"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#30343D}"
                StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>

            <Label Text="{Binding Summary}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#202124, Dark=#FFFFFF}" />
        </Border>

        <!-- Log -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="#22C55E">

            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30"
                                         Spacing="8"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">

                        <Label Text="Історія порожня"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#202124, Dark=#FFFFFF}" />

                        <Label Text="Зафіксованих спрацювань ще немає."
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#A0A4AD}" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AlarmEvent">

                        <Border Margin="0,0,0,10"
                                Padding="14"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1E24}"
                                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#30343D}"
                                StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="6">

                                <!-- Date / time -->
                                <Label Text="{Binding TriggeredAtUtc, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#202124, Dark=#FFFFFF}" />

                                <!-- Trigger count -->
                                <Label Grid.Column="1"
                                       Text="{Binding TriggerCount, StringFormat='× {0}'}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#22C55E"
                                       VerticalTextAlignment="Center" />

                                <!-- Details -->
                                <Label Grid.Row="1"
                                       Text="{Binding Sensitivity, StringFormat='Чутливість: {0}'}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#A0A4AD}" />

                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding SirenStatusText}"
                                       FontSize="13"
                                       HorizontalTextAlignment="End"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#A0A4AD}" />
                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
