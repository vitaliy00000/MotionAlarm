<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotionAlarm.Pages.HomePage"
             Title="Охорона">
    <Grid Padding="24" RowDefinitions="Auto,*" RowSpacing="24">
        <VerticalStackLayout Grid.Row="0" Spacing="6" HorizontalOptions="Center">
            <Label Text="{Binding StatusMessage}"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource TextPrimary}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center">
            <Border WidthRequest="250"
                    HeightRequest="250"
                    StrokeThickness="8"
                    BackgroundColor="{StaticResource BellSurface}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="125" />
                </Border.StrokeShape>
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsArmed}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource AccentStrong}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsArmed}" Value="False">
                        <Setter Property="Stroke" Value="{StaticResource Stroke}" />
                    </DataTrigger>
                </Border.Triggers>

                <Button Command="{Binding ToggleAlarmCommand}"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        CornerRadius="125"
                        WidthRequest="250"
                        HeightRequest="250"
                        Padding="0"
                        Margin="0"
                        FontSize="28"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsArmed}" Value="True">
                            <Setter Property="Text" Value="ВИМКНУТИ" />
                            <Setter Property="TextColor" Value="{StaticResource AccentStrong}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsArmed}" Value="False">
                            <Setter Property="Text" Value="УВІМКНУТИ" />
                            <Setter Property="TextColor" Value="{StaticResource BellOutline}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Border>
        </Grid>
    </Grid>
</ContentPage>