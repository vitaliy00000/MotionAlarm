<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Dark theme palette -->
    <Color x:Key="AppBackground">#222B3D</Color>
    <Color x:Key="Surface">#2A3448</Color>
    <Color x:Key="SurfaceAlt">#243045</Color>
    <Color x:Key="Stroke">#3A465E</Color>

    <Color x:Key="TextPrimary">#F3F6FB</Color>
    <Color x:Key="TextSecondary">#A6B1C5</Color>
    <Color x:Key="TextMuted">#7D889F</Color>

    <Color x:Key="Accent">#FF6A1A</Color>
    <Color x:Key="AccentStrong">#FF7E22</Color>

    <!-- "Bell" light surface from reference image -->
    <Color x:Key="BellSurface">#F7F8FB</Color>
    <Color x:Key="BellOutline">#212B3F</Color>
</ResourceDictionary>